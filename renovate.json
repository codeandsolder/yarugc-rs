{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet",
    "github>codeandsolder/ci-workflows:renovate-native-automerge"
  ],
  "packageRules": [
    {
      "description": "Keep imaging crates on one Git revision to preserve shared Rust type identity",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "/^https:\\/\\/github\\.com\\/forest-rs\\/imaging(?:\\.git)?$/"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "Imaging Git family",
      "groupSlug": "imaging-git-family"
    },
    {
      "description": "Update SVG parser and renderer together to preserve the shared Tree type",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "usvg",
        "resvg"
      ],
      "groupName": "SVG parser and renderer",
      "groupSlug": "svg-parser-renderer"
    }
  ]
}
